# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated code (Riverpod, Hive, etc.)
**/*.g.dart

# Environment and Secrets - IMPORTANT!
.env
.env.*
*.env

# Firebase Config (contains project IDs)
*google-services*.json
GoogleService-Info.plist

# Temp analysis and heap dumps
*.txt
*.hprof

# Local Firestore backups (scripts/backup-firestore.js writes here). Each one
# contains every user's data in plain text. The pattern in backend/.gitignore
# does not reach this directory — it sits at the repository root.
/backups/

# Firebase service account keys. Committing one hands anyone with repo access
# full admin on the database.
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json

# Local session handoff notes. References local key paths and env var
# names -- this repo is public, so it stays out of it.
HANDOFF.md
