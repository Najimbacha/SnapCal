# Keep uploaded source as narrow as the container context.
**
!Dockerfile
!.dockerignore
!.gcloudignore
!package.json
!package-lock.json
!*.js
!services/
!services/**
!cron/
!cron/**
!legal/
!legal/**
!data/
!data/nutrition_db.json
!data/food_aliases.json
!data/usda_aliases.json
**/.env*
**/*credential*
**/*service-account*
**/*.pem
**/*.key
