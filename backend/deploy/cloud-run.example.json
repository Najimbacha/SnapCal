{
  "project": "snapcal-ef333",
  "service": "snapcal-api",
  "region": "us-central1",
  "firestoreLocation": "nam5",
  "serviceAccount": "snapcal-run@snapcal-ef333.iam.gserviceaccount.com",
  "memory": "1Gi",
  "env": {
    "NODE_ENV": "production",
    "REQUIRE_APP_CHECK": "true",
    "REQUIRE_SHARED_REDIS": "true",
    "API_RATE_LIMIT": "120",
    "SCAN_RATE_LIMIT": "20",
    "WEBHOOK_RATE_LIMIT": "120",
    "IP_RATE_LIMIT": "1000",
    "MAX_JSON_BODY": "2mb",
    "MAX_IMAGE_BODY": "14mb",
    "TRUST_PROXY_COUNT": "1",
    "MAX_CONCURRENT_SCANS": "10",
    "SHUTDOWN_DRAIN_MS": "0",
    "SHUTDOWN_TIMEOUT_MS": "9000",
    "ENTITLEMENT_CACHE_TTL": "60",
    "AUDIT_LOG_RETENTION_DAYS": "365",
    "REVENUECAT_EVENT_RETENTION_DAYS": "90",
    "FREE_MONTHLY_SCANS": "15",
    "MAX_BONUS_SCANS_PER_MONTH": "10",
    "FREE_DAILY_AI_MESSAGES": "1",
    "FREE_DAILY_AI_REQUESTS": "30",
    "AI_IMAGE_PROVIDER_ORDER": "deepseek",
    "AI_TEXT_PROVIDER_ORDER": "deepseek",
    "SCAN_PIPELINE": "v2",
    "AI_IMAGE_DETECTION_MAX_TOKENS": "1536",
    "AI_RETRY_LIMIT": "2",
    "SCAN_RESULT_CACHE_TTL_SECONDS": "604800",
    "NUTRITION_CACHE_TTL_SECONDS": "2592000",
    "FIREBASE_STORAGE_BUCKET": "snapcal-ef333.firebasestorage.app",
    "ALLOWED_ORIGINS": ""
  },
  "secrets": {
    "DEEPSEEK_API_KEY": "snapcal-deepseek:1",
    "REVENUECAT_WEBHOOK_AUTH": "snapcal-revenuecat-webhook:1",
    "REVENUECAT_SECRET_API_KEY": "snapcal-revenuecat-api:1",
    "REDIS_URL": "snapcal-redis-url:2",
    "SCHEDULER_SECRET": "snapcal-scheduler:1",
    "METRICS_TOKEN": "snapcal-metrics:1"
  }
}
